[
 {
  "rule": "RoboDR: Interactive shell started on robot controller",
  "note": "bash -i reverse shell",
  "expect": true,
  "event": {
   "header": {
    "image": "/usr/bin/bash"
   },
   "payload": {
    "filename": "/usr/bin/bash",
    "argc": 2,
    "argv": [
     "bash",
     "-i"
    ]
   }
  }
 },
 {
  "rule": "RoboDR: Interactive shell started on robot controller",
  "note": "busybox sh -i",
  "expect": true,

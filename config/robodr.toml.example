# RoboDR configuration overlay for the Pulsar daemon.
#
# Drop these blocks into the Pulsar config (pulsar.toml). RoboDR modules are
# OFF by default; enable only the ones this robot needs.

[robodr-sensor-ros2]
enabled = true
# Path to the locked model profile for THIS robot model.
profile_path = "/etc/robodr/profile.json"
# DDS defaults for RTPS domain 0. Change spdp_port for another domain:
#   port = 7400 + 250 * domain_id
spdp_group = "239.255.0.1"
spdp_port = 7400
# Interface to join the multicast group on; 0.0.0.0 uses the default route.
interface = "0.0.0.0"

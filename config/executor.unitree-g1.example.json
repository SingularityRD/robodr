{
  "schema": "robodr-executor-config/v1",
  "robot_id": "g1-001",
  "socket": "/run/robodr-executor/executor.sock",
  "key_file": "/run/credentials/robodr-executor.service/executor.key",
  "state_dir": "/var/lib/robodr/executor",
  "policy_path": "/etc/robodr/response-policy.json",
  "network": {
    "management": [
      {"cidr": "10.20.0.0/24", "proto": "tcp", "port": 22, "note": "operator SSH (illustrative)"}
    ],
    "uplink": [
      {"cidr": "10.20.0.10", "proto": "tcp", "port": 443, "note": "AutoSecOps ingest API (illustrative)"}
    ],
    "control_buses": {"exempt": true, "entries": [{"cidr": "192.168.123.0/24", "note": "Unitree robot network"}]},
    "motion_control_path": [
      {"cidr": "192.168.123.0/24", "low_level": true, "note": "Unitree robot network: rt/lowcmd and rt/lowstate (the balance loop); never cut"},
      {"cidr": "192.168.123.0/24", "guid_prefix": "0110d0d0d0d0d0d0d0d00000", "low_level": true, "note": "rt/lowcmd writer (synthetic placeholder: take the GUID prefix from your commissioning learn report); a guid_prefix only narrows an entry, it always needs cidr and/or interface"}
    ]
  },
  "ttl": {"default_s": 600, "max_s": 3600}
}

# The ROS 2 peer image with rmw_cyclonedds_cpp (tools/e2e/ros2-peer/run.sh
# cyclonedds robodr-ros2-cyclone). ROS_DISTRO follows the base image.
# The base is pinned by its index digest (as run.sh's stock image).
ARG BASE=mirror.gcr.io/library/ros:humble-ros-core@sha256:def377f78b58f925e26a2f1f082708d5efed8a602ed43f66449c73618df349a9
FROM ${BASE}
RUN apt-get update \
 && apt-get install -y --no-install-recommends ros-${ROS_DISTRO}-rmw-cyclonedds-cpp \
 && rm -rf /var/lib/apt/lists/*

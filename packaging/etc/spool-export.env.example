# EXAMPLE settings for robodr-spool-export.service (robot side, diode sites).
# Install as /etc/robodr/spool-export.env, mode 0640 root:robodr:
#   install -m 0640 -o root -g robodr spool-export.env.example /etc/robodr/spool-export.env
# The unit refuses to start without this file (AssertPathExists=).
# Key: /etc/robodr/keys/diode.key (0600 root:root), a dedicated
# `robodr-blackbox keygen` Ed25519 key; its .pub goes to the SOC importer.

# Required: the unit id written into every batch manifest. TUNE.
ROBODR_UNIT_ID=unit-001

# Optional extra flags (split on white space), see robodr-spool-export(1),
# e.g. --interval-ms 5000 --max-findings 10000 --max-batch-bytes 16777216
# The rejected directory is kept in full unless bounded, e.g.
#   --rejected-max-age-s 7776000 --rejected-max-count 100000
ROBODR_SPOOL_EXPORT_ARGS=

# EXAMPLE settings for robodr-kafka-publish.service (connected sites: the
# unit or sensor box publishes agentd's spool straight to Kafka).
# Install as /etc/robodr/kafka-publish.env, mode 0640 root:robodr:
#   install -m 0640 -o root -g robodr kafka-publish.env.example /etc/robodr/kafka-publish.env
# The unit refuses to start without this file (AssertPathExists=), and can
# reach no broker until the 50-brokers.conf drop-in lists them.

# Required: one --bootstrap per bootstrap broker, IP:PORT (IPv6: [addr]:port).
# Documentation placeholders (RFC 5737): replace them. TUNE.
ROBODR_KAFKA_BOOTSTRAP="--bootstrap 192.0.2.21:9092 --bootstrap 192.0.2.22:9092"

# Optional extra flags (split on white space), see robodr-kafka-publish(1),
# e.g. --topic robodr.findings --interval-ms 2000
ROBODR_KAFKA_PUBLISH_ARGS=

# Refresh /run/robodr-metrics/robodr.prom every 15 s (see
# robodr-metrics.service). Installed disabled: systemctl enable --now
# robodr-metrics.timer. Alert on the age of
# robodr_metrics_last_run_timestamp_seconds to catch a stopped timer.

[Unit]
Description=Refresh RoboDR metrics every 15 s
Documentation=man:robodr-metrics(1)

[Timer]
OnBootSec=30s
OnUnitActiveSec=15s
AccuracySec=1s

[Install]
WantedBy=timers.target

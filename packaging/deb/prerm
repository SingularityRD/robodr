#!/bin/sh
# robodr prerm. Stops the services on removal; on upgrade they keep running
# until postinst try-restarts them on the new binaries (the gateway and the
# executor only through the safety-state gate: postinst, gated_restart).
set -e

case "$1" in
remove | deconfigure)
    # >>> variant_switch_prerm (crates/robodr-deliverd/tests/install_bundle.rs runs this script)
    # A variant switch: dpkg removes this package in favour of the other
    # RoboDR variant (robodr <-> robodr-focal conflict and replace each
    # other). For the services that is an upgrade, not a removal (review
    # H6): nothing is stopped (stopping the gateway here would bypass the
    # safety-state gate, and stopping robodr-deliverd would kill the dpkg
    # run it waits for), the executor's nft table stays (its actions keep
    # their TTLs), and the marker tells the new variant's postinst to take
    # the upgrade path.
    if [ "$1" = remove ] && [ "${2:-}" = in-favour ]; then
        case "${3:-}" in
        robodr | robodr-focal)
            mkdir -p /var/lib/robodr
            echo "${DPKG_MAINTSCRIPT_PACKAGE:-robodr} ${3}" >/var/lib/robodr/.variant-switch
            exit 0
            ;;
        esac
    fi
    rm -f /var/lib/robodr/.variant-switch
    # <<< variant_switch_prerm
    if [ -d /run/systemd/system ]; then
        # robodr-firewall-gw-rules is deliberately not stopped (it has no
        # ExecStop=): the ruleset stays, so with fail_closed the bridge keeps
        # refusing motion datagrams after the gateway is removed. Take the
        # gateway out of the path explicitly (OPERATIONS.md 6.6).
        for u in robodr-spool-export.service robodr-kafka-publish.service robodr-uplink.service \
            robodr-agentd.service robodr-pulsard.service robodr-anchor-receiver.service \
            robodr-executor.service robodr-firewall-gw.service robodr-deliverd.service \
            robodr-depot.service robodr-metrics.timer robodr-metrics.service; do
            systemctl stop "$u" 2>/dev/null || true
        done
    fi
    # executor v1: without the executor nothing would lift its actions at
    # their TTL, so its table goes with it (only this table, never another).
    if command -v nft >/dev/null 2>&1 && nft list table inet robodr >/dev/null 2>&1; then
        nft delete table inet robodr || true
    fi
    ;;
upgrade | failed-upgrade) ;;
*)
    echo "prerm called with unknown argument '$1'" >&2
    exit 1
    ;;
esac

exit 0

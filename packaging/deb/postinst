#!/bin/sh
# robodr postinst. Creates the robodr user and directories, reloads systemd.
# Services are NOT enabled or started on first install: an uncommissioned
# robot must not start enforcing (OPERATIONS.md, "Commissioning"). On upgrade,
# services that were running are restarted on the new binaries, except the
# gateway and the executor (gated_restart below).
set -e

# >>> migrate_agentd_tree (tests/review2_13b.rs runs this block)
# migrate_agentd_tree DIR OLD_OWNER NEW_OWNER GROUP
#
# Give agentd's tree DIR (owned by OLD_OWNER, the user agentd and the
# exporters shared before review H1) to NEW_OWNER:GROUP. Every step is
# idempotent, so an interrupted run is simply repeated:
#   1. a symlink, FIFO, socket or device in the tree is removed (agentd
#      creates none there; a planted link would otherwise be followed);
#   2. a regular file with more than one link is replaced by a copy (same
#      owner, mode and times), so the inode shared with a file elsewhere is
#      left alone and keeps its owner;
#   3. entries of OLD_OWNER get NEW_OWNER:GROUP (chown -h, find -P: no
#      symlink is ever followed, no other file system is entered);
#   4. group/other write is removed everywhere, setuid/setgid from files.
# Directory modes and the spool queues' group write and setgid bit come
# back from tmpfiles afterwards.
migrate_agentd_tree() {
    mt_dir=$1
    mt_old=$2
    mt_owner=$3:$4
    if [ ! -d "$mt_dir" ] || [ -L "$mt_dir" ]; then
        return 0
    fi
    find -P "$mt_dir" -xdev -mindepth 1 ! -type f ! -type d -exec rm -f -- {} +
    find -P "$mt_dir" -xdev -type f -links +1 -exec sh -c '
        for f do
            t="$f.robodr-migrate"
            rm -f -- "$t"
            cp -P --preserve=mode,ownership,timestamps -- "$f" "$t"
            mv -f -- "$t" "$f"
        done' sh {} +
    find -P "$mt_dir" -xdev -user "$mt_old" -exec chown -h "$mt_owner" {} +
    find -P "$mt_dir" -xdev \( -type f -o -type d \) -perm /022 -exec chmod go-w {} +
    find -P "$mt_dir" -xdev -type f -perm /6000 -exec chmod ug-s {} +
}
# <<< migrate_agentd_tree

# >>> migrate_exporter_users (packaging/rpm/post carries the same block;
# scripts/check-packages.py keeps them identical)
# Upgrade from a release where robodr-spool-export, robodr-kafka-publish,
# robodr-uplink and robodr-firewall-gw all ran as the shared user robodr
# (review: each could read the others' credentials and rewrite their
# state). Each now has its own user; the state those releases wrote as
# robodr moves to it once, with the four units stopped, by the same
# link-safe, resumable steps as the agentd migration (migrate_agentd_tree:
# no symlink followed, hardlinks broken, group/other write and
# setuid/setgid removed). Marker: /var/lib/robodr/.exporter-users-migrated.
migrate_exporter_users() {
    meu_marker=/var/lib/robodr/.exporter-users-migrated
    [ ! -e "$meu_marker" ] || return 0
    if [ -d /run/systemd/system ]; then
        for u in robodr-spool-export.service robodr-kafka-publish.service \
            robodr-uplink.service robodr-firewall-gw.service; do
            if systemctl is-active --quiet "$u"; then
                systemctl stop "$u"
                stopped="$stopped $u"
            fi
        done
    fi
    for meu_pair in /var/lib/robodr/export/diode:robodr-spool \
        /var/lib/robodr/export/spool-export:robodr-spool \
        /var/lib/robodr/export/kafka-publish:robodr-kafka \
        /var/lib/robodr/export/uplink:robodr-uplink \
        /var/lib/robodr/firewall-gw:robodr-gw; do
        # cut, not parameter expansion: rpm scriptlets may not contain a percent sign.
        meu_dir=$(echo "$meu_pair" | cut -d: -f1)
        migrate_agentd_tree "$meu_dir" robodr "${meu_pair#*:}" robodr
    done
    mkdir -p /var/lib/robodr
    : >"$meu_marker"
}
# <<< migrate_exporter_users

# >>> gated_restart (the same block in packaging/deb/postinst and packaging/rpm/post)
# T9: robodr-firewall-gw and robodr-executor are never restarted by a
# package upgrade: restarting the gateway drops the motion commands
# queued in it (fail_closed: the bridge refuses motion while it is down),
# restarting the executor drops its pending actions. They keep running
# the previous binaries and are recorded in /var/lib/robodr/pending-restart
# (robodr-agentd reports it as robot.agent.restart_pending while it stays);
# install-bundle.sh restarts them only while the live safety state is
# idle or safe_state_active (or with --allow-gateway-restart), at once or
# later with `install-bundle.sh restart-pending` (OPERATIONS.md 7).
mark_pending_restart() { # unit
    systemctl is-active --quiet "$1" || return 0
    # Already started on the new binaries by the user migration.
    case " $stopped " in *" $1 "*) return 0 ;; esac
    mkdir -p /var/lib/robodr
    grep -qx "$1" /var/lib/robodr/pending-restart 2>/dev/null ||
        echo "$1" >>/var/lib/robodr/pending-restart
    # robodr-agentd (group robodr) reads it and reports
    # robot.agent.restart_pending to the SOC while it stays.
    chgrp robodr /var/lib/robodr/pending-restart 2>/dev/null || true
    chmod 0640 /var/lib/robodr/pending-restart 2>/dev/null || true
    echo "robodr: $1 keeps running the previous binaries until a safety-gated restart:"
    echo "robodr:   /usr/lib/robodr/install-bundle.sh restart-pending (OPERATIONS.md 7)"
}

# The one-time gateway user migration (migrate_exporter_users) stops the
# gateway. It runs only when install-bundle.sh found the safety state to
# allow it (ROBODR_GATED_RESTART=allow); otherwise the configuration is
# refused before anything is stopped, and the gateway keeps running.
gateway_migration_gate() {
    [ ! -e /var/lib/robodr/.exporter-users-migrated ] || return 0
    [ -d /run/systemd/system ] || return 0
    [ "${ROBODR_GATED_RESTART:-}" != allow ] || return 0
    systemctl is-active --quiet robodr-firewall-gw.service || return 0
    echo "robodr: this upgrade must stop robodr-firewall-gw once to move its state to its own" >&2
    echo "robodr: user, and nothing said the safety state allows that. Nothing was stopped." >&2
    echo "robodr: When the robot is idle or in its safe state, run" >&2
    echo "robodr:   /usr/lib/robodr/install-bundle.sh restart-pending   (.deb), or" >&2
    echo "robodr:   install the release again with install-bundle.sh install (OPERATIONS.md 7)." >&2
    exit 1
}
# <<< gated_restart

stopped=""
case "$1" in
configure)
    gateway_migration_gate
    if command -v systemd-sysusers >/dev/null 2>&1; then
        systemd-sysusers /usr/lib/sysusers.d/robodr.conf
    elif ! getent passwd robodr >/dev/null; then
        # Fallback for hosts without systemd-sysusers.
        adduser --system --group --home /var/lib/robodr --no-create-home \
            --shell /usr/sbin/nologin robodr
    fi
    if ! command -v systemd-sysusers >/dev/null 2>&1 && ! getent passwd robodr-exec >/dev/null; then
        adduser --system --ingroup robodr --home /var/lib/robodr/executor --no-create-home \
            --shell /usr/sbin/nologin robodr-exec
    fi
    if ! command -v systemd-sysusers >/dev/null 2>&1; then
        if ! getent passwd robodr-agentd >/dev/null; then
            adduser --system --group --home /var/lib/robodr --no-create-home \
                --shell /usr/sbin/nologin robodr-agentd
        fi
        adduser robodr-agentd robodr >/dev/null
        getent group robodr-safety >/dev/null || addgroup --system robodr-safety
        if ! getent passwd robodr-depot >/dev/null; then
            adduser --system --group --home /var/lib/robodr/depot --no-create-home \
                --shell /usr/sbin/nologin robodr-depot
        fi
        adduser robodr-depot robodr >/dev/null
        # One user per network-facing service (their units set
        # Group=robodr; sysusers.d/robodr.conf).
        for u in robodr-spool robodr-kafka robodr-uplink robodr-gw; do
            if ! getent passwd "$u" >/dev/null; then
                adduser --system --group --home /var/lib/robodr --no-create-home \
                    --shell /usr/sbin/nologin "$u"
            fi
        done
    fi
    # Upgrade from a version where robodr-agentd ran as robodr (review H1):
    # agentd's own trees move to its own user before tmpfiles sets the
    # directory modes. Review L-E: the exporters ran as robodr too, so
    # anything in those trees may have been planted by one of them. The
    # migration therefore runs with agentd and the exporters stopped, never
    # follows a symlink, breaks hardlinks, strips group/other write and
    # setuid/setgid from files, and is resumable: it runs until it has
    # completed once (the marker in the root-owned /var/lib/robodr).
    migrated=/var/lib/robodr/.agentd-user-migrated
    stopped=""
    if [ ! -e "$migrated" ]; then
        if [ -d /run/systemd/system ]; then
            for u in robodr-spool-export.service robodr-kafka-publish.service \
                robodr-uplink.service robodr-agentd.service; do
                if systemctl is-active --quiet "$u"; then
                    systemctl stop "$u"
                    stopped="$stopped $u"
                fi
            done
        fi
        for d in /var/lib/robodr/blackbox/agentd /var/lib/robodr/spool/agentd \
            /var/lib/robodr/profile-state /var/lib/robodr/control-plane/agentd; do
            migrate_agentd_tree "$d" robodr robodr-agentd robodr
        done
        mkdir -p /var/lib/robodr
        : >"$migrated"
    fi
    migrate_exporter_users
    if command -v systemd-tmpfiles >/dev/null 2>&1; then
        systemd-tmpfiles --create /usr/lib/tmpfiles.d/robodr.conf
    fi
    # First install: the executor's first-start marker. Without it a
    # missing sealed journal is taken for a deleted one (reset, orders
    # refused until `rearm`); the first start consumes it. Never on an
    # upgrade.
    exec_state=/var/lib/robodr/executor
    if [ -z "$2" ] && [ -d "$exec_state" ] && [ ! -L "$exec_state" ] \
        && [ ! -e "$exec_state/journal.json" ] && [ ! -e "$exec_state/sealed" ]; then
        install -m 0600 -o robodr-exec -g robodr /dev/null "$exec_state/first-start"
    fi
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload || true
        # What the migration stopped starts again on the new binaries.
        for u in $stopped; do
            systemctl start "$u" || true
        done
        if [ -n "$2" ]; then
            # Upgrade: restart only what was running, but never the gateway
            # or the executor (gated_restart, below).
            # >>> restart_on_upgrade (crates/robodr-deliverd/tests/kinds.rs runs this block)
            # Under robodr-deliverd (its dpkg runs carry
            # ROBODR_DELIVERD_INSTALL=1) the agent is not restarted here: it
            # waits for this dpkg run, and stopping its unit would kill dpkg
            # and this script with it. It restarts itself once its pass is
            # done (it exits 3 when its binary was replaced; T52).
            for u in robodr-pulsard.service robodr-agentd.service robodr-anchor-receiver.service \
                robodr-spool-export.service robodr-kafka-publish.service robodr-uplink.service \
                robodr-deliverd.service robodr-depot.service; do
                if [ "$u" = robodr-deliverd.service ] && [ "${ROBODR_DELIVERD_INSTALL:-}" = 1 ]; then
                    continue
                fi
                systemctl try-restart "$u" || true
            done
            # <<< restart_on_upgrade
            for u in robodr-executor.service robodr-firewall-gw.service; do
                mark_pending_restart "$u"
            done
        else
            echo "robodr: installed. Services are disabled until commissioning is"
            echo "robodr: complete: see /usr/share/doc/robodr/OPERATIONS.md"
        fi
    fi
    ;;
abort-upgrade | abort-remove | abort-deconfigure) ;;
*)
    echo "postinst called with unknown argument '$1'" >&2
    exit 1
    ;;
esac

exit 0

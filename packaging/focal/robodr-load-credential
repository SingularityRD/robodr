#!/bin/sh
# robodr-load-credential: LoadCredential= for systemd < 247 (robodr-focal).
#
# Installed as /usr/lib/robodr/robodr-load-credential by the robodr-focal
# package only. Ubuntu 20.04 / JetPack 5 ship systemd 245, which has no
# LoadCredential=. The focal units call this helper with the "+" prefix
# (ExecStartPre=+ / ExecStopPost=+: run as root, outside the unit's sandbox)
# to do the same job:
#
#   robodr-load-credential load  <unit> <user> <name>:<source> [<name>:<source> ...]
#   robodr-load-credential clear <unit>
#
# <user> is never root, except for the units in root_units below whose
# service runs as root (robodr-deliverd).
#
# load   copies each root-only <source> (e.g. /etc/robodr/keys/agentd-blackbox.key)
#        to /run/credentials/<unit>/<name>, mode 0400, owned by <user>, in a
#        root-owned 0711 directory: the same path systemd >= 247 uses, so
#        agentd.json is identical on both packages. The service can read its
#        copy but cannot replace or delete it, and /etc/robodr/keys stays
#        0700 root:root (the unit's InaccessiblePaths= still hides it).
# clear  removes /run/credentials/<unit> (ExecStopPost=, and at every start
#        before load so a dropped credential does not linger).
#
# Difference to LoadCredential=: the copy is on /run (tmpfs, swappable),
# not on a private non-swappable credential mount, and it exists while the unit is
# active only because ExecStopPost= removes it. Encrypt swap (or run without
# swap) where that matters; docs/UNITREE.md 3.2.
#
# Exit: 0 ok, 1 error (the unit then fails to start: fail closed), 2 usage.
set -eu
umask 077
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

base=/run/credentials

# Units whose service itself runs as root (User=root) and so takes its
# credentials as root. Every other unit runs unprivileged, so root there is
# a wrong unit or drop-in and is still refused (fail closed). Space-separated
# unit names; scripts/check-focal-units.py checks that it lists exactly the
# focal units that load credentials for root.
root_units='robodr-deliverd.service'

die() { echo "robodr-load-credential: $2" >&2; exit "$1"; }

# Unit and credential names: one path component, no dot-only names.
valid_name() {
    case "$1" in
    '' | . | .. | */* | *[!A-Za-z0-9._@:-]*) return 1 ;;
    esac
    return 0
}

[ "$(id -u)" -eq 0 ] || die 2 "must run as root (use the '+' prefix in the unit)"
[ $# -ge 2 ] || die 2 "usage: $0 load <unit> <user> <name>:<source>... | clear <unit>"
cmd=$1
unit=$2
valid_name "$unit" || die 2 "invalid unit name '$unit'"
dir=$base/$unit

case "$cmd" in
clear)
    [ $# -eq 2 ] || die 2 "usage: $0 clear <unit>"
    rm -rf -- "$dir"
    ;;
load)
    [ $# -ge 4 ] || die 2 "usage: $0 load <unit> <user> <name>:<source>..."
    user=$3
    shift 3
    # Upgrade compatibility (13b review 2, I-C): operator drop-ins copied
    # from the examples of releases where agentd ran as robodr still name
    # that user, and agentd (now robodr-agentd) could not read its own
    # credentials and would fail to start. A credential of
    # robodr-agentd.service always goes to robodr-agentd.
    if [ "$unit" = robodr-agentd.service ] && [ "$user" = robodr ] &&
        id -u robodr-agentd >/dev/null 2>&1; then
        echo "robodr-load-credential: $unit: handing the credentials to robodr-agentd, not robodr" \
            "(update the drop-in: docs/OPERATIONS.md 11.5)" >&2
        user=robodr-agentd
    fi
    # The same for the units that ran as the shared robodr user until each
    # got its own (review: with one uid, every one of them could read the
    # others' credentials). A credential of these units is never handed to
    # robodr: to the unit's own user if it exists, else refused.
    own=""
    case "$unit" in
    robodr-spool-export.service) own=robodr-spool ;;
    robodr-kafka-publish.service) own=robodr-kafka ;;
    robodr-uplink.service) own=robodr-uplink ;;
    robodr-firewall-gw.service) own=robodr-gw ;;
    esac
    if [ -n "$own" ] && [ "$user" = robodr ]; then
        id -u "$own" >/dev/null 2>&1 ||
            die 2 "$unit: refusing to hand a credential to the shared user robodr, and its own user $own does not exist (reinstall the package: docs/OPERATIONS.md 11.6)"
        echo "robodr-load-credential: $unit: handing the credentials to $own, not robodr" \
            "(update the drop-in: docs/OPERATIONS.md 11.6)" >&2
        user=$own
    fi
    uid=$(id -u "$user" 2>/dev/null) || die 1 "unknown user '$user'"
    gid=$(id -g "$user")
    if [ "$uid" -eq 0 ]; then
        case " $root_units " in
        *" $unit "*) ;;
        *) die 2 "$unit: refusing to hand a credential to root (only for: $root_units)" ;;
        esac
    fi
    # The parent and unit directories must be real directories owned by
    # root, never symlinks (a planted link would redirect the copy).
    for d in "$base" "$dir"; do
        if [ -L "$d" ]; then die 1 "$d is a symlink"; fi
        if [ -e "$d" ] && [ ! -d "$d" ]; then die 1 "$d is not a directory"; fi
    done
    install -d -m 0755 -o 0 -g 0 "$base"
    install -d -m 0711 -o 0 -g 0 "$dir"
    for spec in "$@"; do
        case "$spec" in *:*) ;; *) die 2 "credential '$spec' is not <name>:<source>" ;; esac
        name=${spec%%:*}
        src=${spec#*:}
        valid_name "$name" || die 2 "invalid credential name '$name'"
        case "$src" in /*) ;; *) die 2 "source '$src' must be an absolute path" ;; esac
        if [ -L "$src" ] || [ ! -f "$src" ]; then
            die 1 "source $src is missing or not a regular file"
        fi
        tmp=$dir/.$name.$$
        rm -f -- "$tmp"
        install -m 0400 -o "$uid" -g "$gid" -- "$src" "$tmp"
        mv -f -- "$tmp" "$dir/$name"
    done
    ;;
*)
    die 2 "unknown command '$cmd' (load | clear)"
    ;;
esac
exit 0

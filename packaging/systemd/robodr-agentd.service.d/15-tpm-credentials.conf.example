# EXAMPLE drop-in, not active as shipped (needs systemd >= 250 and a TPM 2.0;
# not shipped for the focal variant). To use it, see docs/OPERATIONS.md,
# "Robot keys sealed to the TPM" (SALES-READINESS T66):
#
#   install -d -m 0750 -o root -g robodr-agentd /etc/robodr/credstore.encrypted
#   systemd-creds encrypt --with-key=host+tpm2 --tpm2-pcrs=7 --name=blackbox.key \
#       /etc/robodr/keys/agentd-blackbox.key /etc/robodr/credstore.encrypted/blackbox.key
#   chgrp robodr-agentd /etc/robodr/credstore.encrypted/blackbox.key
#   chmod 0640 /etc/robodr/credstore.encrypted/blackbox.key
#   install -D -m 0644 15-tpm-credentials.conf.example \
#       /etc/systemd/system/robodr-agentd.service.d/15-tpm-credentials.conf
#   systemctl daemon-reload && systemctl restart robodr-agentd
#   # then, after checking the service runs, destroy the plaintext key
#   # (see docs/OPERATIONS.md for flash storage).
#
# systemd (PID 1) decrypts the credential with this machine's TPM (and, with
# host+tpm2, the root-only /var/lib/systemd/credential.secret) at every start
# and exposes it, as before, at
#   /run/credentials/robodr-agentd.service/blackbox.key
# so agentd.json keeps "key_file": "/run/credentials/robodr-agentd.service/blackbox.key".
# A copied disk or SD card no longer yields the key.
#
# agentd reads the header of /etc/robodr/credstore.encrypted/<name> (never
# decrypting it; hence group robodr-agentd, mode 0640: the ciphertext is
# useless without the TPM and the host secret) and reports each key's
# protection in status.json "key_protection". To refuse to start on any key
# that is not TPM-sealed, add to agentd.json:
#   "key_protection": { "require": "tpm2" }
#
# Other keys (finding.key, cp-tls.key, anchor-tls.key, executor.key) are
# sealed the same way: in their own drop-in, replace their LoadCredential=
# line by LoadCredentialEncrypted=<name>:/etc/robodr/credstore.encrypted/<name>.
[Service]
# Reset the unit's plain LoadCredential=blackbox.key (an empty assignment
# clears the list; drop-ins named 20-* and later add their own entries
# after this one).
LoadCredential=
LoadCredentialEncrypted=blackbox.key:/etc/robodr/credstore.encrypted/blackbox.key

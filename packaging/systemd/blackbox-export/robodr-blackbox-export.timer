# Runs robodr-blackbox-export.service (docs/OPERATIONS.md 8.2): every
# 15 minutes, and 5 minutes after boot. Size the interval with the
# black-box sizing table (OPERATIONS 6.4): the export must run well inside
# the time the pending-export reserve covers at the unit's write rate.
#
# Installed disabled:
#   systemctl enable --now robodr-blackbox-export.timer

[Unit]
Description=RoboDR black-box export (periodic)
Documentation=file:/usr/share/doc/robodr/OPERATIONS.md

[Timer]
OnBootSec=5min
OnUnitActiveSec=15min
RandomizedDelaySec=60
Persistent=false

[Install]
WantedBy=timers.target

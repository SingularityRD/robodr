# EXAMPLE drop-in for the robodr-focal package (systemd 245), not active as
# shipped. Same purpose as the regular package's
# 60-tls-credentials.conf.example (packaging/systemd/
# robodr-kafka-publish.service.d/), with /usr/lib/robodr/robodr-load-credential
# in place of LoadCredential= (systemd 247). Hands robodr-kafka-publish the
# secrets of mutual TLS and / or SASL/SCRAM (docs/OPERATIONS.md section 8.3):
# the helper (root, '+' prefix) copies the root-only files to
#   /run/credentials/robodr-kafka-publish.service/<name>
# (0400, owned by robodr, in a root-owned 0711 directory), the same paths as
# on the regular package, so /etc/robodr/kafka-publish.env is identical.
# To use it (keep only the credentials you need in the "load" line; a listed
# file that is missing stops the unit from starting):
#   install -D -m 0644 60-tls-credentials.conf.example \
#       /etc/systemd/system/robodr-kafka-publish.service.d/60-tls-credentials.conf
#   install -m 0600 -o root -g root client.key   /etc/robodr/kafka/client.key
#   install -m 0600 -o root -g root sasl.password /etc/robodr/kafka/sasl.password
#   systemctl daemon-reload && systemctl restart robodr-kafka-publish
# and point ROBODR_KAFKA_TLS_ARGS (/etc/robodr/kafka-publish.env) at
#   --tls-key /run/credentials/robodr-kafka-publish.service/kafka-client.key
#   --sasl-password-file /run/credentials/robodr-kafka-publish.service/kafka-sasl.password
# The CA file and the client certificate are not secret: /etc/robodr/kafka/
# ca.pem and client.pem, 0644 root.
# The unit itself loads no credential, so this drop-in brings its own
# "clear" lines: stale copies are removed before every start and after stop.

[Service]
ExecStartPre=+/usr/lib/robodr/robodr-load-credential clear robodr-kafka-publish.service
ExecStartPre=+/usr/lib/robodr/robodr-load-credential load robodr-kafka-publish.service robodr kafka-client.key:/etc/robodr/kafka/client.key kafka-sasl.password:/etc/robodr/kafka/sasl.password
ExecStopPost=+/usr/lib/robodr/robodr-load-credential clear robodr-kafka-publish.service
InaccessiblePaths=-/etc/robodr/kafka/client.key -/etc/robodr/kafka/sasl.password

# EXAMPLE drop-in for the robodr-focal package (systemd 245), not active as
# shipped. Same purpose as the regular package's 30-control-plane.conf.example
# (packaging/systemd/robodr-agentd.service.d/), with
# /usr/lib/robodr/robodr-load-credential in place of LoadCredential=
# (systemd 247). To use it:
#   install -D -m 0644 30-control-plane.conf.example \
#       /etc/systemd/system/robodr-agentd.service.d/30-control-plane.conf
#   (edit IPAddressAllow= below for your SOC network)
#   systemctl daemon-reload && systemctl restart robodr-agentd
#
# The control-plane API robodr-control-plane/v2 (docs/OPERATIONS.md section
# 6.5): its private state directory (control_plane.state_dir, created 0700
# robodr:robodr by tmpfiles.d), the robot's TLS server key copied by the
# helper (root, '+' prefix) to
#   /run/credentials/robodr-agentd.service/cp-tls.key
# (0400, owned by robodr; control_plane.tls.key_file), and the SOC network
# (the unit has IPAddressDeny=any). This line runs after the unit's own
# ExecStartPre= lines (drop-ins append); ExecStopPost= of the unit removes
# the copies. Requires the finding-key drop-in (answers are signed).
[Service]
ReadWritePaths=/var/lib/robodr/control-plane/agentd
ExecStartPre=+/usr/lib/robodr/robodr-load-credential load robodr-agentd.service robodr cp-tls.key:/etc/robodr/keys/agentd-cp-tls.key
IPAddressAllow=192.0.2.0/24

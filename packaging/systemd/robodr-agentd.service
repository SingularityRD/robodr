# robodr-agentd: RoboDR decision chain (event -> deviation -> plan -> black
# box -> OCSF finding) as a long-running daemon.
#
# PROTECTIVE ONLY. The agent detects, records evidence and *requests* a safe
# state through the platform's own interface; it never overrides the safety
# system, the e-stop or the platform's command authority, and nothing in the
# robot's motion stack may depend on this unit being up.
#
# Checked against the merged robodr-agentd (crates/robodr-agentd):
#   * CLI: `robodr-agentd --config <agentd.json> [--check-config]`; exit 0
#     clean stop (SIGTERM/SIGINT seal the black box), 1 runtime failure,
#     2 usage/configuration error (nothing started; not restarted, below).
#   * /etc/robodr/agentd.json must set (absolute paths, strict JSON):
#       "blackbox": { "dir": "/var/lib/robodr/blackbox/agentd",
#                     "key_file": "/run/credentials/robodr-agentd.service/blackbox.key" },
#       "spool":    { "dir": "/var/lib/robodr/spool/agentd" }
#     The key file is a `robodr-blackbox keygen` secret key file (Ed25519 by
#     default, robodr-blackbox-key/v2; key id taken from it; verifiers get
#     only the FILE.pub). Legacy HMAC files and bare hex still load, with a
#     start-up warning (the verifier could forge). A .pub file is refused.
#     agentd refuses the key unless it is a regular file, mode
#     without group/other bits and owned by root or the daemon's uid, which
#     the systemd credential copy satisfies. An optional unix_socket event
#     input belongs under /run/robodr-agentd/ (RuntimeDirectory= below; the
#     socket is created 0600, so producers must run as robodr-agentd or
#     root); so does the optional safety_feed socket (safety-PLC gateway:
#     0600 by default, or 0660 with socket_group = the robodr-safety gid,
#     and every connection is checked with SO_PEERCRED against root, this
#     daemon's uid and safety_feed.socket.allowed_uids / allowed_gids, so
#     the exporters (their own users) cannot report a safety state; give this
#     unit and the gateway SupplementaryGroups=robodr-safety for that: a
#     supplementary group counts (SO_PEERGROUPS), and agentd refuses to
#     start with the exporters' group robodr as socket_group or in
#     allowed_gids).
#   * spool.status_socket /run/robodr-agentd/status.sock: the status (and
#     the live safety state) served to robodr-deliverd, which accepts it
#     only from this unit's user (SO_PEERCRED; review H1). status.json in
#     the spool is for people and tools, not for the delivery gate (the
#     spool root is 2750 robodr-agentd:robodr; the exporters' group can
#     write only the ready/acked/rejected queues).
#   * Optional per-finding signing key (finding_signing.key_file): installed
#     with the drop-in example 20-finding-key.conf.example (LoadCredential=
#     finding.key), never the black-box key. Only agentd.full.example.json
#     names it; agentd.example.json runs without the drop-in.
#   * sd_notify (std-only, crates/robodr-agentd/src/notify.rs): READY=1 once
#     started (Type=notify), WATCHDOG=1 from the main loop at most every 1 s,
#     STATUS=state <ok|degraded|unknown> each tick, STOPPING=1 at shutdown.
#     A main loop stalled for WatchdogSec= (slow fsync, hang) is killed and
#     restarted. status.json carries updated_mono_ms / boot_id /
#     stale_after_ms: consumers treat a stale status as `unknown`.
#   * It reads /proc/sys/kernel/random/boot_id (chain identity) and
#     /proc/net/{route,fib_trie,if_inet6} (default capture interfaces, local
#     addresses for the binding check), so ProcSubset=pid must NOT be set.
#
# Verify after editing: systemd-analyze verify robodr-agentd.service
#                       systemd-analyze security robodr-agentd.service

[Unit]
Description=RoboDR agent (decision chain, black box, OCSF spool)
Documentation=file:/usr/share/doc/robodr/OPERATIONS.md
AssertPathExists=/etc/robodr/agentd.json
After=local-fs.target network.target
# Start limit KEPT (unlike robodr-pulsard, which never gives up): after 5
# starts in 300 s the unit is left failed (example alert RoboDRUnitFailed).
# Decision recorded for sales-readiness B6, revisit with its measurements:
#  * agentd bounds its input by design: the input queue drops and counts
#    what does not fit (daemon.queue_bytes, below the MemoryMax= budget),
#    so an event storm is meant to cost dropped input, not a kill at
#    MemoryMax= (not yet measured on the target). robodr-pulsard got its
#    never-give-up policy because a storm can push it to its own cap.
#  * Every agentd process increments the TPM NV counter at its first
#    black-box head mark (head_anchor kind tpm_nv_counter; the 60 s limit in
#    crates/robodr-blackbox/src/tpm_anchor.rs lives in memory). Restarting
#    every RestartSec=5s without end would write TPM NV about 12 times as
#    often as that limit allows, against the part's write endurance.
# If B6 shows agentd can reach MemoryMax= under a storm, switch to
# StartLimitIntervalSec=0 together with a restart delay of at least the
# anchor's increment interval, or persist that interval across restarts.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/sbin/robodr-agentd --config /etc/robodr/agentd.json
Restart=on-failure
RestartSec=5s
# Exit 2 = usage or configuration error: restarting cannot fix it.
RestartPreventExitStatus=2
TimeoutStopSec=30s
# The main loop pings every <= 1 s; 60 s leaves room for a slow (but
# progressing) fsync of critical evidence before the loop is declared hung.
WatchdogSec=60s

# --- Memory ------------------------------------------------------------------
# agentd must never be the reason the motion stack is OOM-killed:
#   * OOMScoreAdjust is POSITIVE: under system-wide memory pressure the
#     kernel picks agentd before the platform's processes (default 0). Losing
#     the monitor is visible (stale status.json, missing heartbeats, the
#     watchdog/restart); losing the motion stack is a safety event.
#   * MemoryMax= caps the whole unit, so a runaway agentd hits its own
#     cgroup limit (and only agentd is killed, then restarted by
#     Restart=on-failure) long before it can pressure the rest of the robot.
#     Budget: input queue <= daemon.queue_bytes (default 32 MiB, max 256 MiB),
#     pipeline/agent state bounded by their own caps, the black box streams
#     to disk. MemoryHigh= throttles (reclaim) before the hard cap.
#     These figures are estimates, not measured on the target: size them
#     from the commissioning run (systemctl show -p MemoryPeak).
OOMScoreAdjust=200
MemoryHigh=384M
MemoryMax=512M

# --- Identity and capabilities ---------------------------------------------
# Dedicated, unprivileged system user of its own (packaging/sysusers.d/
# robodr.conf), distinct from the exporters' robodr (review H1). Member of
# robodr for /etc/robodr, its findings spool (setgid robodr, read and acked
# by the exporters) and the executor's socket.
User=robodr-agentd
Group=robodr-agentd
SupplementaryGroups=robodr
# The only privilege: read-only passive capture (AF_PACKET) of the robot's
# DDS traffic. Ambient so the unprivileged process actually holds it;
# bounded so it can never hold anything else.
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
NoNewPrivileges=yes
UMask=0027

# --- Key material ------------------------------------------------------------
# systemd (PID 1, root) reads the root-only key file and exposes a copy to
# this service alone, on a private non-swappable credential mount, readable
# only by User= (and root):
#   /run/credentials/robodr-agentd.service/blackbox.key
# systemd < 254 (or kernel < 6.4): ramfs, the copy is 0400 owned by User=.
# systemd >= 254 on kernel >= 6.4 (Ubuntu 24.04, Debian 13): a read-only
# tmpfs, the copy is 0440 root:root with a POSIX ACL user:<User=>:r-- (ls
# shows -r--r-----+: the group bits are the ACL mask). agentd accepts that
# form only when the ACL lets nobody but root and User= read the file
# (robodr_blackbox::secret_file; packaging/README.md, "Key material").
# The robodr-agentd user itself has no access to /etc/robodr/keys.
LoadCredential=blackbox.key:/etc/robodr/keys/agentd-blackbox.key
InaccessiblePaths=-/etc/robodr/keys

# --- Filesystem --------------------------------------------------------------
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
# profile-state: the anti-rollback state (sensor.profile_trust.state_file,
# /var/lib/robodr/profile-state/agentd.json), written atomically at start.
# Without it the daemon cannot record the accepted profile and, failing
# closed, runs observe-only.
ReadWritePaths=/var/lib/robodr/blackbox/agentd /var/lib/robodr/spool/agentd /var/lib/robodr/profile-state
# Sockets: events.sock (optional event input), safety.sock (safety-PLC
# gateway), host-threats.sock (Pulsar forwarder), status.sock (deliverd).
# 0751: other users may reach a socket they are allowed to (its own mode
# and the SO_PEERCRED checks decide), not list the directory.
RuntimeDirectory=robodr-agentd
RuntimeDirectoryMode=0751
ProtectProc=invisible
# No ProcSubset=pid: agentd reads /proc/sys/kernel/random/boot_id and
# /proc/net/{route,fib_trie,if_inet6} (see the header).
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes

# --- Network -----------------------------------------------------------------
# Read-only on networks: AF_PACKET for capture, AF_NETLINK/AF_UNIX for
# interface lookup and the journal. AF_INET is kept only because interface
# lookups (if_nametoindex/ioctl) may need a datagram socket; IPAddressDeny=
# blocks all IP traffic from this unit (AF_PACKET capture is not affected).
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_PACKET AF_INET AF_INET6
IPAddressDeny=any

# --- Kernel interfaces / syscalls -------------------------------------------
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete @mount @swap @reboot @raw-io @cpu-emulation @clock @module @debug
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target

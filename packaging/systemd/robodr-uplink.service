# robodr-uplink: CONNECTED-site findings uplink to the SOC's ingest API
# (AutoSecOps, contract docs/contracts/robodr.ingest-api.md). Reads
# robodr-agentd's spool on this host (the robot's companion computer or a
# sensor box) and POSTs signed NDJSON batches over TLS
# (man robodr-uplink(1), docs/OPERATIONS.md section 8.5).
#
# Where robodr-uplink runs:
#   * Connected site: HERE, on the unit or the sensor box, with --spool
#     (this unit) and the unit's `uplink` key.
#   * Air-gapped / diode site: on the SOC (high) side, after
#     robodr-diode-unpack, with --diode-out and a `relay` key. That host has
#     its own layout; give it its own unit (e.g. copy this one, change
#     ExecStart=, User= and ReadWritePaths=). This unit is not for that case.
# robodr-spool-export, robodr-kafka-publish and this unit all consume
# agentd's spool, so they conflict: enable exactly one.
#
# Checked against crates/robodr-export (robodr-uplink --help):
#   * CLI: --url URL --key-file FILE --ca-bundle PEM [--spki-sha256 HEX ...]
#     --state-dir DIR --spool DIR [--interval-ms N] [--once] ...; without
#     --once it loops every --interval-ms (default 2000 ms) and retries after
#     errors itself (exponential backoff); exit 2 = usage error, exit 1 =
#     key / CA bundle could not be loaded (restarted by systemd).
#   * With --spool it renames <spool>/ready/* to acked/ (rejected/ for
#     lines the server or the local validation refused) only after a 200
#     names them, so it runs as the daemon's user (User=robodr).
#   * --key-file: an Ed25519 secret key file (`robodr-blackbox keygen`,
#     derived key id), registered in AutoSecOps as this robot's `uplink`
#     key. Regular file, no group/other access, owned by root or the
#     process's uid; the systemd credential copy satisfies it. Use a
#     dedicated key, never agentd's black-box or finding key.
#   * TLS is mandatory (plain http:// only to a loopback IP literal); the CA
#     bundle is the only trust anchor; --spki-sha256 pins the server key.
#   * Name resolution: IP literals are used directly; a host name goes
#     through the system resolver, which IPAddressDeny=any blocks unless the
#     DNS server is allowed too. The URL host must be the name (or IP) the
#     server certificate is issued for: put the name in /etc/hosts, or allow
#     the DNS server in the drop-in.
#
# Site settings: /etc/robodr/uplink.env (0640 root:robodr), from
# /usr/share/doc/robodr/examples/uplink.env.example:
#   ROBODR_UPLINK_URL=https://soc.example.org/api           (required)
#   ROBODR_UPLINK_ARGS="--spki-sha256 <64 hex>"              (optional extra flags)
# Key: /etc/robodr/keys/uplink.key (0600 root:root).
# CA bundle: /etc/robodr/uplink-ca.pem (0644; the SOC's CA certificate(s)).
# Network: install the drop-in example
#   /usr/share/doc/robodr/examples/robodr-uplink.service.d/50-soc.conf.example
# with the SOC address(es). Without it this unit can reach no address at
# all (IPAddressDeny=any below) and fails closed.
#
# Installed disabled. Enable after commissioning:
#   systemctl enable --now robodr-uplink
# Verify after editing: systemd-analyze verify robodr-uplink.service
#                       systemd-analyze security robodr-uplink.service

[Unit]
Description=RoboDR findings uplink (agentd spool to the SOC ingest API, connected sites)
Documentation=man:robodr-uplink(1) file:/usr/share/doc/robodr/OPERATIONS.md
AssertPathExists=/etc/robodr/uplink.env
After=local-fs.target network-online.target robodr-agentd.service
Wants=network-online.target
# One consumer per spool.
Conflicts=robodr-spool-export.service robodr-kafka-publish.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# sd_notify STATUS= (blocked queue, last error, backlog: `systemctl status
# robodr-uplink`); the full state is /var/lib/robodr/export/uplink/
# uplink-status.json. Exit 3 = failing longer than --exit-when-stuck-s
# (off unless set in ROBODR_UPLINK_ARGS): restarted like any failure.
NotifyAccess=main
EnvironmentFile=/etc/robodr/uplink.env
# ${ROBODR_UPLINK_URL} is one argument (empty if unset: a usage error, exit
# 2); $ROBODR_UPLINK_ARGS is split on white space and may be empty.
ExecStart=/usr/bin/robodr-uplink --url ${ROBODR_UPLINK_URL} --key-file /run/credentials/robodr-uplink.service/uplink.key --ca-bundle /etc/robodr/uplink-ca.pem --state-dir /var/lib/robodr/export/uplink --spool /var/lib/robodr/spool/agentd $ROBODR_UPLINK_ARGS
Restart=on-failure
RestartSec=10s
# Exit 2 = usage error (bad flags or URL): restarting cannot fix it.
RestartPreventExitStatus=2
TimeoutStopSec=30s
# Never the reason the motion stack is OOM-killed (as robodr-agentd).
OOMScoreAdjust=300
MemoryHigh=192M
MemoryMax=256M
TasksMax=32
# Background work: below the robot's processes for CPU and disk.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

# --- Identity and capabilities ---------------------------------------------
User=robodr
Group=robodr
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
UMask=0027

# --- Key material ------------------------------------------------------------
# systemd (PID 1) copies the root-only key for this unit alone:
#   /run/credentials/robodr-uplink.service/uplink.key
LoadCredential=uplink.key:/etc/robodr/keys/uplink.key
InaccessiblePaths=-/etc/robodr/keys

# --- Filesystem --------------------------------------------------------------
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ReadWritePaths=/var/lib/robodr/spool/agentd /var/lib/robodr/export/uplink
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes

# --- Network ---------------------------------------------------------------------
# Deny every IP address; the 50-soc.conf drop-in adds IPAddressAllow= for
# the SOC ingest address(es) (an address on IPAddressAllow= is allowed even
# though IPAddressDeny=any also matches it).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any

# --- Kernel interfaces / syscalls -------------------------------------------
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete @mount @swap @reboot @raw-io @cpu-emulation @clock @module @debug
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target

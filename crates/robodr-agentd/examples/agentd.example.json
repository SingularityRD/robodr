{
  "robot": {
    "id": "ugv-007",
    "site": "depot-north",
    "kafka_partitions": 12
  },
  "sensor": {
    "profile_path": "/etc/robodr/profile.json",
    "domain_id": 0,
    "listen_spdp": false,
    "capture": {
      "enabled": true,
      "interfaces": ["lo", "eth0"]
    },
    "binding": {
      "enabled": true,
      "hold_ms": 30000
    },
    "profile_trust": {
      "trusted_keys": "/etc/robodr/profile-trust.json",
      "state_file": "/var/lib/robodr/profile-state/agentd.json",
      "expect_platform": "ugv-x1",
      "trust_roots": "/etc/robodr/trust-roots.json",
      "revocation_list": "/etc/robodr/profile-revocations.json",
      "revocation_policy": "optional"
    }
  },
  "policy_path": "/etc/robodr/policy.json",
  "blackbox": {
    "dir": "/var/lib/robodr/blackbox",
    "key_file": "/etc/robodr/blackbox.key"
  },
  "spool": {
    "dir": "/var/spool/robodr/findings",
    "max_bytes": 67108864,
    "max_files": 10000
  },
  "event_inputs": [
    { "kind": "unix_socket", "path": "/run/robodr/events.sock", "max_connections": 4 }
  ],
  "context": {
    "safety_state": "unknown",
    "control": "autonomous",
    "phase": "unknown",
    "connectivity": "connected",
    "operator_present": true
  },
  "firewall": {
    "max_angular": { "/cmd_vel": 1.0 }
  },
  "motion_monitor": {
    "feedback_sources": { "/odom": "wheel_odometry" }
  },
  "safety_feed": {
    "stale_after_ms": 1000,
    "topics": [
      { "topic": "/estop", "type": "std_msgs/msg/Bool",
        "values": { "true": "estop_active", "false": "none" },
        "writers": ["0110a2b3c4d5e6f701000000"] },
      { "topic": "/robot_mode", "type": "std_msgs/msg/UInt8",
        "values": { "0": "idle", "1": "moving_slow", "2": "moving_fast",
                    "3": "collaborative_human_nearby", "4": "safe_state_active" },
        "writers": ["0110a2b3c4d5e6f701000000"] },
      { "topic": "/odom", "type": "nav_msgs/msg/Odometry",
        "motion": { "moving_above": 0.05, "fast_above": 1.0, "angular_moving_above": 0.1,
                    "hysteresis": 0.02 },
        "writers": ["0110a2b3c4d5e6f701000000"] }
    ],
    "socket": { "path": "/run/robodr/safety.sock", "max_connections": 2 }
  },
  "correlation": {
    "enabled": true,
    "rules_path": "/etc/robodr/correlation-rules.json",
    "include_default_rules": true
  },
  "finding_signing": {
    "key_file": "/etc/robodr/keys/agentd-finding.key"
  },
  "daemon": {
    "queue_capacity": 4096,
    "tick_ms": 1000,
    "heartbeat_ms": 10000,
    "silence_ms": 30000,
    "lag_ms": 2000,
    "health_report_ms": 10000,
    "exit_when_inputs_end": false
  }
}

#!/bin/sh
# robodr-signer-pkcs11: a robodr-signer/v1 external signer (see
# crates/robodr-signer/src/lib.rs) over a PKCS#11 token: YubiKey (ykcs11 or
# OpenSC), Nitrokey, SoftHSM, a network HSM's PKCS#11 module. It drives
# OpenSC's pkcs11-tool with CKM_EDDSA (pure Ed25519), so the private key
# never leaves the token.
#
#   robodr-signer-pkcs11 sign       TOKEN... --id HEX (--pin-env NAME | --pin-file FILE)
#       stdin: the message; stdout: the 64-byte signature (raw)
#   robodr-signer-pkcs11 public-key TOKEN... --id HEX
#       stdout: the key's Ed25519 public key, 64 hex digits
#   robodr-signer-pkcs11 signer-file TOKEN... --id HEX --key-id ID
#                        (--pin-env NAME | --pin-file FILE) [--adapter PATH]
#       stdout: a robodr-signer/v1 signer file for this key (the public key
#       is read from the token now and pinned in the file)
#
#   TOKEN: --module /abs/path/to/pkcs11-module.so [--token-label LABEL | --slot N]
#          [--timeout SECONDS]
#
# Deadline: every pkcs11-tool run is limited to --timeout seconds (default
# 110, at most 590) by coreutils "timeout --foreground" (SIGTERM, then
# SIGKILL 5 seconds later). robodr-signer enforces its own deadline
# (timeout_ms) by killing the adapter's process group, but only while the
# caller lives: after a Ctrl-C at the terminal the caller is gone, and this
# inner deadline is what stops a pkcs11-tool still waiting on the token.
# signer-file passes a given --timeout on and sets the file's timeout_ms
# 10 seconds above it (default 120000).
#
# PIN: sign and signer-file need exactly one of --pin-env NAME (the PIN is
# in that environment variable; list NAME in the signer file's "pass_env")
# or --pin-file FILE (first line of FILE, which must be a non-empty regular
# file owned by the caller or root with no group or other permission bits,
# e.g. mode 0600 or 0400). There is no terminal prompt: the
# adapter's stdin is the message and robodr-signer runs it in its own
# process group, so a prompt would get no PIN and could spend one of the
# token's PIN retries. The PIN is never put on a command line:
# pkcs11-tool reads it with "--pin env:VAR", relied on from OpenSC 0.25
# (a pkcs11-tool without that form would send the literal text "env:VAR"
# as the PIN and spend a retry each time). The OpenSC version is read with
# "opensc-tool --info" (the opensc-tool in the same directory as the
# pkcs11-tool found in PATH; without one the adapter refuses, since another
# opensc-tool may belong to another OpenSC install) and anything older than
# 0.25, or unknown, is refused before the token is touched. Tested with 0.25.0-rc1 (Ubuntu 24.04).
#
# Exit 0 on success; anything else on failure (messages on stderr). The
# caller verifies every signature against the pinned public key.

set -eu

die() {
    echo "robodr-signer-pkcs11: $*" >&2
    exit 1
}

[ $# -ge 1 ] || die "usage: robodr-signer-pkcs11 sign|public-key|signer-file --module SO --id HEX ..."
op=$1
shift

module=
token_label=
slot=
id=
pin_env=
pin_file=
key_id=
adapter=/usr/lib/robodr/robodr-signer-pkcs11
deadline=

while [ $# -gt 0 ]; do
    [ $# -ge 2 ] || die "$1 needs a value"
    case $1 in
        --module) module=$2 ;;
        --token-label) token_label=$2 ;;
        --slot) slot=$2 ;;
        --id) id=$2 ;;
        --pin-env) pin_env=$2 ;;
        --pin-file) pin_file=$2 ;;
        --key-id) key_id=$2 ;;
        --adapter) adapter=$2 ;;
        --timeout) deadline=$2 ;;
        *) die "unknown option $1" ;;
    esac
    shift 2
done

# Values end up in a JSON file and on pkcs11-tool's command line: keep them
# to plain characters (no quoting games).
plain() {
    case $2 in
        "" | *[!A-Za-z0-9._/+:@-]*) die "$1 must be non-empty [A-Za-z0-9._/+:@-]" ;;
    esac
}

plain --module "$module"
case $module in /*) ;; *) die "--module must be an absolute path" ;; esac
[ -f "$module" ] || die "--module $module: no such file"
case $id in "" | *[!0-9A-Fa-f]*) die "--id must be hex (the CKA_ID of the key)" ;; esac
[ -z "$token_label" ] || plain --token-label "$token_label"
case $slot in *[!0-9]*) die "--slot must be a number" ;; esac
[ -z "$token_label" ] || [ -z "$slot" ] || die "--token-label and --slot exclude each other"
if [ -n "$pin_env" ]; then
    case $pin_env in [A-Z_]*) ;; *) die "--pin-env must name a variable [A-Z_][A-Z0-9_]*" ;; esac
    case $pin_env in *[!A-Z0-9_]*) die "--pin-env must name a variable [A-Z_][A-Z0-9_]*" ;; esac
fi
[ -z "$pin_env" ] || [ -z "$pin_file" ] || die "--pin-env and --pin-file exclude each other"
[ -z "$pin_file" ] || plain --pin-file "$pin_file"
timeout_given=$deadline
case $deadline in
    "") deadline=110 ;;
    0* | *[!0-9]*) die "--timeout must be a number of seconds, 1 to 590" ;;
esac
if [ "${#deadline}" -gt 3 ] || [ "$deadline" -gt 590 ]; then
    die "--timeout must be a number of seconds, 1 to 590"
fi

p11tool=$(command -v pkcs11-tool 2>/dev/null) || die "pkcs11-tool (OpenSC) not found in PATH"
case $p11tool in /*) ;; *) die "pkcs11-tool resolves to $p11tool, not an absolute path" ;; esac
command -v timeout >/dev/null 2>&1 || die "timeout (coreutils) not found in PATH: needed for the --timeout deadline"

# Every pkcs11-tool run, under the deadline. --foreground keeps it in this
# process group, so robodr-signer's group kill still reaches it.
p11() {
    timeout --foreground -k 5 "$deadline" "$p11tool" "$@"
}

# The OpenSC release behind pkcs11-tool must understand "--pin env:VAR"
# (0.25 and later). Checked before any login: an older pkcs11-tool would
# log in with the literal string as the PIN and spend a retry (a YubiKey
# PIV locks after 3).
check_opensc() {
    ot="${p11tool%/*}/opensc-tool"
    if [ ! -f "$ot" ] || [ ! -x "$ot" ]; then
        die "no opensc-tool next to $p11tool: cannot check that this pkcs11-tool's OpenSC is 0.25 or later (needed for --pin env:VAR)"
    fi
    ver=$("$ot" --info 2>/dev/null | sed -n '1s/^OpenSC \([0-9][0-9]*\)\.\([0-9][0-9]*\).*/\1 \2/p')
    [ -n "$ver" ] || die "cannot read the OpenSC version from $ot --info (0.25 or later needed)"
    # Split on purpose: two numbers.
    # shellcheck disable=SC2086
    set -- $ver
    [ "$1" -gt 0 ] || [ "$2" -ge 25 ] ||
        die "OpenSC $1.$2 is too old: 0.25 or later is needed (pkcs11-tool --pin env:VAR); refusing to log in"
}

# A PIN source is required for anything that logs in (see the header).
need_pin() {
    [ -n "$pin_env" ] || [ -n "$pin_file" ] ||
        die "$op needs --pin-env NAME or --pin-file FILE (there is no terminal prompt)"
}

# The PIN file: a regular file owned by the caller or root, no group or
# other permission bits.
check_pin_file() {
    st=$(stat -L -c '%u %a %F' -- "$pin_file" 2>/dev/null) || die "--pin-file $pin_file: cannot stat it"
    # Split on purpose: uid, octal mode, file type (digits and letters).
    # shellcheck disable=SC2086
    set -- $st
    # GNU stat says "regular empty file" for an empty one.
    case "$3 ${4:-} ${5:-}" in
        "regular file ") ;;
        "regular empty file") die "--pin-file $pin_file is empty" ;;
        *) die "--pin-file $pin_file is not a regular file" ;;
    esac
    [ "$1" = 0 ] || [ "$1" = "$(id -u)" ] ||
        die "--pin-file $pin_file is owned by uid $1, not by you or root"
    case $2 in
        0 | [0-7]00 | [0-7][0-7]00) ;;
        *) die "--pin-file $pin_file has mode $2: group or others have access (chmod 0600)" ;;
    esac
    [ -r "$pin_file" ] || die "--pin-file $pin_file is not readable"
}

set -- --module "$module"
if [ -n "$token_label" ]; then
    set -- "$@" --token-label "$token_label"
elif [ -n "$slot" ]; then
    set -- "$@" --slot "$slot"
fi

umask 077
tmp=$(mktemp -d) || die "mktemp failed"
trap 'rm -rf "$tmp"' EXIT HUP INT TERM

public_key_hex() {
    p11 "$@" --read-object --type pubkey --id "$id" -o "$tmp/pub" >/dev/null 2>"$tmp/err" ||
        { cat "$tmp/err" >&2; die "reading public key $id failed (or timed out after ${deadline}s)"; }
    if head -c 11 "$tmp/pub" | grep -q -- '-----BEGIN'; then
        grep -v -- '-----' "$tmp/pub" | base64 -d >"$tmp/pub.der" 2>/dev/null ||
            die "public key $id: bad PEM"
    else
        cp "$tmp/pub" "$tmp/pub.der"
    fi
    # Ed25519 SubjectPublicKeyInfo: 12-byte prefix (OID 1.3.101.112) + 32.
    [ "$(wc -c <"$tmp/pub.der" | tr -d ' ')" = 44 ] || die "key $id is not an Ed25519 key"
    [ "$(head -c 12 "$tmp/pub.der" | od -An -v -tx1 | tr -d ' \n')" = 302a300506032b6570032100 ] ||
        die "key $id is not an Ed25519 key"
    tail -c 32 "$tmp/pub.der" | od -An -v -tx1 | tr -d ' \n'
}

case $op in
    sign)
        need_pin
        check_opensc
        if [ -n "$pin_file" ]; then
            check_pin_file
            ROBODR_P11_PIN=$(head -n 1 "$pin_file")
            [ -n "$ROBODR_P11_PIN" ] || die "--pin-file $pin_file: the first line is empty"
            export ROBODR_P11_PIN
            set -- "$@" --login --pin env:ROBODR_P11_PIN
        else
            eval "[ -n \"\${$pin_env:-}\" ]" || die "--pin-env $pin_env is not set (list it in pass_env)"
            set -- "$@" --login --pin "env:$pin_env"
        fi
        cat >"$tmp/msg"
        # pkcs11-tool's chatter goes to stderr; stdout carries only the
        # signature.
        p11 "$@" --sign --mechanism EDDSA --id "$id" \
            -i "$tmp/msg" -o "$tmp/sig" >&2 || die "signing with key $id failed (or timed out after ${deadline}s)"
        [ "$(wc -c <"$tmp/sig" | tr -d ' ')" = 64 ] || die "the token returned no Ed25519 signature"
        cat "$tmp/sig"
        ;;
    public-key)
        public_key_hex "$@"
        echo
        ;;
    signer-file)
        [ -n "$key_id" ] || die "signer-file needs --key-id"
        # The signer file it writes must work: same checks as sign.
        need_pin
        check_opensc
        [ -z "$pin_file" ] || check_pin_file
        plain --key-id "$key_id"
        plain --adapter "$adapter"
        pub=$(public_key_hex "$@")
        tok=""
        [ -z "$token_label" ] || tok=", \"--token-label\", \"$token_label\""
        [ -z "$slot" ] || tok=", \"--slot\", \"$slot\""
        pin=""
        pass=""
        if [ -n "$pin_env" ]; then
            pin=", \"--pin-env\", \"$pin_env\""
            pass=",
  \"pass_env\": [\"$pin_env\"]"
        elif [ -n "$pin_file" ]; then
            pin=", \"--pin-file\", \"$pin_file\""
        fi
        tmo=""
        timeout_ms=120000
        if [ -n "$timeout_given" ]; then
            tmo=", \"--timeout\", \"$deadline\""
            timeout_ms=$(((deadline + 10) * 1000))
        fi
        cat <<EOF
{
  "format": "robodr-signer/v1",
  "backend": "external",
  "key_id": "$key_id",
  "public_key_hex": "$pub",
  "command": ["$adapter", "sign", "--module", "$module"$tok, "--id", "$id"$pin$tmo]$pass,
  "timeout_ms": $timeout_ms
}
EOF
        ;;
    *)
        die "unknown operation $op (sign, public-key, signer-file)"
        ;;
esac

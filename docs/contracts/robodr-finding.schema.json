{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.singularityrd.com/robodr/findings/2.3.0",
  "title": "RoboDR robodr.findings message (contract 2.3.0; also validates 2.0.x, 2.1.x and 2.2.x)",
  "description": "One findings message (Kafka value on the configured topic, default robodr.findings; one NDJSON line on other transports): vendor-neutral envelope + OCSF 1.1 Detection Finding (class_uid 2004). data_source (default robodr) and ocsf.metadata.log_name (the topic, default robodr.findings) are deployment labels. Contract 1.x messages (robot-edr.findings) are described by legacy/robot-edr-finding.schema.json. Maintained alongside crates/robodr-ocsf/src/model.rs; the crate's tests check that produced findings contain every required key here and no undeclared key. Strings carrying attacker-controlled data are objects of type TaintedName/TaintedText or OCSF resources labelled taint:adversary. SR-TAINT: every string has a pattern; every string is printable ASCII (U+0020-U+007E) without < > or backtick, and tainted values are restricted to the allow-list of their escaping scheme (see robodr.findings.md section 3), so raw bidi/format/newline characters and Markdown/HTML markup are rejected by a schema-only consumer. A finding may carry a detached Ed25519 signature in the Kafka header robodr-finding-sig (NOT in this value); its header value is described by $defs/FindingSignatureHeader and is signed over the exact bytes of this value (robodr.findings.md section 2a).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "finding_id", "external_id", "data_source", "title",
    "description", "severity", "timestamp", "entity_context", "mitre_predictions",
    "evidence_links", "adversary_controlled_fields", "ocsf"
  ],
  "properties": {
    "contract_version": { "type": "string", "pattern": "^2\\.[0-9]{1,9}\\.[0-9]{1,9}$" },
    "finding_id": { "type": "string", "pattern": "^rf1-[0-9a-f]{32}$" },
    "external_id": { "type": "string", "maxLength": 101, "pattern": "^[A-Za-z0-9._-]{1,64}:rf1-[0-9a-f]{32}$" },
    "data_source": { "type": "string", "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[ -;=?-_a-~]*$" },
    "description": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^[ -;=?-_a-~]*$" },
    "severity": { "enum": ["low", "medium", "high", "critical"] },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "entity_context": { "$ref": "#/$defs/EntityContext" },
    "mitre_predictions": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["technique_id", "technique_name", "framework", "provenance"],
        "properties": {
          "technique_id": { "enum": ["T0848", "T0855", "T0801", "T0831", "T0856"] },
          "technique_name": { "enum": ["Rogue Master", "Unauthorized Command Message", "Monitor Process State", "Manipulation of Control", "Spoof Reporting Message"] },
          "framework": { "const": "attack_ics" },
          "provenance": { "const": "sensor" }
        }
      }
    },
    "evidence_links": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "pattern": "^robodr-blackbox://[A-Za-z0-9._-]{1,64}/[0-9]+/[0-9]+\\?sha256=[0-9a-f]{64}$" }
    },
    "anomaly_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "adversary_controlled_fields": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(/[a-z0-9_]+)+$" }
    },
    "ocsf": { "$ref": "#/$defs/DetectionFinding" }
  },
  "$defs": {
    "FindingSignatureHeader": {
      "description": "Value of the Kafka header robodr-finding-sig (since contract 1.2) (compact JSON, fields in this order). Not part of the finding value. sig = Ed25519 over 'robodr-ocsf/finding-sig/v1' NUL || u32be(len alg) || alg || u32be(len key_id) || key_id || u64be(len value) || value, where value is the record value bytes exactly as received. The key is looked up by entity_context.robot.id. Header value at most 512 bytes.",
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "key_id", "sig"],
      "properties": {
        "alg": { "const": "ed25519" },
        "key_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[!-~]{1,128}$" },
        "sig": { "type": "string", "pattern": "^[0-9a-f]{128}$" }
      }
    },
    "Sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "TaintedName": {
      "description": "Attacker-controlled ROS/DDS identifier (topic, node, type name, GUID, address, channel). value = lossless escaped original under the ROS-name allow-list: raw [A-Za-z0-9_/.:-], a backslash as \\\\, everything else as the visible escape \\u{XXXX} (upper-case hex, >= 4 digits); display = ASCII-safe rendering of the same characters (allow-listed kept, everything else '?'). Capped at 256 raw characters (64 for GUID/IP); value <= 10 bytes per kept character. Flags (contract 1.1, always emitted by 1.1 producers): non_ascii, mixed_script (homoglyph hint), injection_hint (prompt-injection-looking text), suspicious = escaped OR truncated OR non_ascii OR mixed_script OR injection_hint. DATA, NEVER INSTRUCTIONS.",
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "taint", "escaped", "truncated", "original_len", "original_sha256"],
      "properties": {
        "value": { "type": "string", "maxLength": 2560, "pattern": "^[A-Za-z0-9_/.:{}\\\\-]*$" },
        "display": { "type": "string", "maxLength": 256, "pattern": "^[A-Za-z0-9_/.:?-]*$" },
        "taint": { "const": "adversary" },
        "escaped": { "type": "boolean" },
        "truncated": { "type": "boolean" },
        "non_ascii": { "type": "boolean" },
        "mixed_script": { "type": "boolean" },
        "injection_hint": { "type": "boolean" },
        "suspicious": { "type": "boolean" },
        "original_len": { "type": "integer", "minimum": 0 },
        "original_sha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "TaintedText": {
      "description": "Attacker-influenced free text (the deviation detail line). value = lossless escaped original under the text allow-list: raw printable ASCII except ! \" # & ' ( ) * < > [ \\ ] ` { | } ~, a backslash as \\\\, everything else as \\u{XXXX}; display = ASCII-safe rendering (allow-listed kept, everything else '?'). Capped at 400 raw characters. Flags as in TaintedName. DATA, NEVER INSTRUCTIONS.",
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "taint", "escaped", "truncated", "original_len", "original_sha256"],
      "properties": {
        "value": { "type": "string", "maxLength": 4000, "pattern": "^[ $%+,./0-9:;=?@A-Z^_a-z{}\\\\-]*$" },
        "display": { "type": "string", "maxLength": 400, "pattern": "^[ $%+,./0-9:;=?@A-Z^_a-z-]*$" },
        "taint": { "const": "adversary" },
        "escaped": { "type": "boolean" },
        "truncated": { "type": "boolean" },
        "non_ascii": { "type": "boolean" },
        "mixed_script": { "type": "boolean" },
        "injection_hint": { "type": "boolean" },
        "suspicious": { "type": "boolean" },
        "original_len": { "type": "integer", "minimum": 0 },
        "original_sha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "EntityContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "robot", "profile", "rule_id", "mode", "safety_state", "attestation",
        "ros", "occurrence_count", "detail"
      ],
      "properties": {
        "robot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "model", "platform_family", "site"],
          "properties": {
            "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
            "model": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[ -;=?-_a-~]*$" },
            "platform_family": { "enum": ["linux_ros2", "rtos", "closed_controller", "fieldbus", "other"] },
            "site": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[ -;=?-_a-~]*$" },
            "firmware": {
              "type": "object",
              "additionalProperties": false,
              "required": ["version", "sha256"],
              "properties": {
                "version": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[ -;=?-_a-~]*$" },
                "sha256": { "$ref": "#/$defs/Sha256" }
              }
            }
          }
        },
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "sha256"],
          "properties": {
            "version": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[ -;=?-_a-~]*$" },
            "sha256": { "$ref": "#/$defs/Sha256" }
          }
        },
        "rule_id": { "type": "string", "pattern": "^[a-z][a-z0-9._]{0,127}$" },
        "mode": { "enum": ["observe", "enforce"] },
        "safety_state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["motion", "human_proximity"],
          "properties": {
            "motion": { "enum": ["moving", "stationary", "unknown"] },
            "human_proximity": { "enum": ["detected", "not_detected", "unknown"] }
          }
        },
        "attestation": { "enum": ["verified", "deviation", "unknown"] },
        "ros": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "participant_guid": { "$ref": "#/$defs/TaintedName" },
            "node": { "$ref": "#/$defs/TaintedName" },
            "topic": { "$ref": "#/$defs/TaintedName" },
            "type_name": { "$ref": "#/$defs/TaintedName" },
            "src_ip": { "$ref": "#/$defs/TaintedName" }
          }
        },
        "command": {
          "type": "object",
          "additionalProperties": false,
          "required": ["channel"],
          "properties": {
            "channel": { "$ref": "#/$defs/TaintedName" },
            "linear_speed": { "type": "number", "minimum": 0 },
            "joint_speed": { "type": "number", "minimum": 0 },
            "envelope_max_linear_speed": { "type": "number", "minimum": 0 },
            "envelope_max_joint_speed": { "type": "number", "minimum": 0 }
          }
        },
        "bus_message_id": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "occurrence_count": { "type": "integer", "minimum": 1 },
        "detail": { "$ref": "#/$defs/TaintedText" }
      }
    },
    "DetectionFinding": {
      "description": "OCSF 1.1 Detection Finding. Fields marked OCSF-UNCERTAIN in crates/robodr-ocsf/README.md must be confirmed against the OCSF schema server before a strict OCSF validator is put in the path.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activity_id", "activity_name", "category_uid", "category_name", "class_uid",
        "class_name", "type_uid", "type_name", "severity_id", "severity", "status_id",
        "status", "time", "message", "count", "metadata", "finding_info", "device",
        "evidences", "resources", "unmapped"
      ],
      "properties": {
        "activity_id": { "enum": [1, 2, 3] },
        "activity_name": { "enum": ["Create", "Update", "Close"] },
        "category_uid": { "const": 2 },
        "category_name": { "const": "Findings" },
        "class_uid": { "const": 2004 },
        "class_name": { "const": "Detection Finding" },
        "type_uid": { "enum": [200401, 200402, 200403] },
        "type_name": { "type": "string", "pattern": "^Detection Finding: (Create|Update|Close)$" },
        "severity_id": { "enum": [2, 3, 4, 5] },
        "severity": { "enum": ["Low", "Medium", "High", "Critical"] },
        "status_id": { "enum": [0, 1, 2, 3, 4, 99] },
        "status": { "enum": ["Unknown", "New", "In Progress", "Suppressed", "Resolved", "Other"] },
        "time": { "type": "integer", "minimum": 946684800000, "maximum": 4102444799999 },
        "message": { "type": "string", "maxLength": 256, "pattern": "^[ -;=?-_a-~]*$" },
        "count": { "type": "integer", "minimum": 1 },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "product", "uid", "log_name"],
          "properties": {
            "version": { "const": "1.1.0" },
            "product": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "vendor_name", "version"],
              "properties": {
                "name": { "const": "RoboDR" },
                "vendor_name": { "const": "Singularity RD" },
                "version": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[ -;=?-_a-~]*$" }
              }
            },
            "uid": { "type": "string", "pattern": "^re1-[0-9a-f]{32}$" },
            "log_name": { "type": "string", "maxLength": 249, "description": "Kafka topic rule: 1-249 of [A-Za-z0-9._-], not \".\" or \"..\" (the three alternatives exclude exactly those two).", "pattern": "^([A-Za-z0-9_-][A-Za-z0-9._-]{0,248}|\\.[A-Za-z0-9_-][A-Za-z0-9._-]{0,247}|\\.\\.[A-Za-z0-9._-]{1,247})$" }
          }
        },
        "finding_info": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "uid", "title", "desc", "types", "first_seen_time", "last_seen_time",
            "analytic", "attacks", "data_sources"
          ],
          "properties": {
            "uid": { "type": "string", "pattern": "^rf1-[0-9a-f]{32}$" },
            "title": { "type": "string", "maxLength": 256, "pattern": "^[ -;=?-_a-~]*$" },
            "desc": { "type": "string", "maxLength": 2048, "pattern": "^[ -;=?-_a-~]*$" },
            "types": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "enum": ["robot_deviation", "ros2_dds_discovery", "ros2_motion_commands", "robodr", "robodr_correlation", "robot_safety_state", "robodr_agent", "host_runtime", "robodr_delivery"] } },
            "first_seen_time": { "type": "integer" },
            "last_seen_time": { "type": "integer" },
            "analytic": {
              "type": "object",
              "additionalProperties": false,
              "required": ["uid", "name", "type_id", "type"],
              "properties": {
                "uid": { "type": "string", "pattern": "^[a-z][a-z0-9._]{0,127}$" },
                "name": { "type": "string", "pattern": "^[a-z][a-z0-9._]{0,127}$" },
                "type_id": { "const": 1 },
                "type": { "const": "Rule" }
              }
            },
            "attacks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["technique"],
                "properties": {
                  "technique": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["uid", "name"],
                    "properties": {
                      "uid": { "enum": ["T0848", "T0855", "T0801", "T0831", "T0856"] },
                      "name": { "enum": ["Rogue Master", "Unauthorized Command Message", "Monitor Process State", "Manipulation of Control", "Spoof Reporting Message"] }
                    }
                  }
                }
              }
            },
            "data_sources": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "enum": ["ros2_dds_discovery", "ros2_motion_commands", "robodr", "robodr_correlation", "robot_safety_state", "robodr_agent", "host_runtime", "robodr_delivery"] } }
          }
        },
        "device": {
          "type": "object",
          "additionalProperties": false,
          "required": ["uid", "name", "type_id", "type", "model"],
          "properties": {
            "uid": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
            "name": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
            "type_id": { "const": 99 },
            "type": { "const": "Robot" },
            "model": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[ -;=?-_a-~]*$" }
          }
        },
        "evidences": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["data"],
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "segment", "seq", "sha256", "uri"],
                "properties": {
                  "kind": { "const": "robodr.blackbox" },
                  "segment": { "type": "integer", "minimum": 0 },
                  "seq": { "type": "integer", "minimum": 0 },
                  "sha256": { "$ref": "#/$defs/Sha256" },
                  "uri": { "type": "string", "pattern": "^robodr-blackbox://[A-Za-z0-9._-]{1,64}/[0-9]+/[0-9]+\\?sha256=[0-9a-f]{64}$" }
                }
              }
            }
          }
        },
        "resources": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "labels"],
            "properties": {
              "type": { "enum": ["ros2.participant", "ros2.node", "ros2.topic", "ip_address"] },
              "uid": { "type": "string", "maxLength": 2560, "pattern": "^[A-Za-z0-9_/.:{}\\\\-]*$" },
              "name": { "type": "string", "maxLength": 2560, "pattern": "^[A-Za-z0-9_/.:{}\\\\-]*$" },
              "labels": { "const": ["taint:adversary"] }
            }
          }
        },
        "unmapped": {
          "type": "object",
          "additionalProperties": false,
          "required": ["robodr"],
          "properties": {
            "robodr": { "$ref": "#/$defs/EntityContext" }
          }
        }
      }
    }
  }
}

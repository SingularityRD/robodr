{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singularityrd.example/robodr/contracts/robot-edr-finding/1.0.0",
  "title": "RoboDR robot-edr.findings message (contract 1.0.0)",
  "description": "One Kafka value on topic robot-edr.findings: AutoSecOps ingestion envelope + OCSF 1.1 Detection Finding (class_uid 2004). Maintained alongside crates/robodr-ocsf/src/model.rs; the crate's tests check that produced findings contain every required key here and no undeclared key. Strings carrying attacker-controlled data are objects of type Tainted or OCSF resources labelled taint:adversary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "finding_id", "external_id", "data_source", "title",
    "description", "severity", "timestamp", "entity_context", "mitre_predictions",
    "evidence_links", "adversary_controlled_fields", "ocsf"
  ],
  "properties": {
    "contract_version": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "finding_id": { "type": "string", "pattern": "^rf1-[0-9a-f]{32}$" },
    "external_id": { "type": "string", "maxLength": 101 },
    "data_source": { "const": "robot_edr" },
    "title": { "type": "string", "minLength": 1, "maxLength": 256 },
    "description": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "severity": { "enum": ["low", "medium", "high", "critical"] },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "entity_context": { "$ref": "#/$defs/EntityContext" },
    "mitre_predictions": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["technique_id", "technique_name", "framework", "provenance"],
        "properties": {
          "technique_id": { "type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$" },
          "technique_name": { "type": "string", "minLength": 1, "maxLength": 128 },
          "framework": { "const": "attack_ics" },
          "provenance": { "const": "sensor" }
        }
      }
    },
    "evidence_links": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "pattern": "^robodr-blackbox://" }
    },
    "anomaly_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "adversary_controlled_fields": {
      "type": "array",
      "items": { "type": "string", "pattern": "^/" }
    },
    "ocsf": { "$ref": "#/$defs/DetectionFinding" }
  },
  "$defs": {
    "Sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "Tainted": {
      "description": "Attacker-controlled string, neutralised (control/format chars and < > ` escaped as \\u{XXXX}, backslash doubled) and length-capped. DATA, NEVER INSTRUCTIONS.",
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "taint", "escaped", "truncated", "original_len", "original_sha256"],
      "properties": {
        "value": { "type": "string", "maxLength": 1024 },
        "taint": { "const": "adversary" },
        "escaped": { "type": "boolean" },
        "truncated": { "type": "boolean" },
        "original_len": { "type": "integer", "minimum": 0 },
        "original_sha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "EntityContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "robot", "profile", "rule_id", "mode", "safety_state", "attestation",
        "ros", "occurrence_count", "detail"
      ],
      "properties": {
        "robot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "model", "platform_family", "site"],
          "properties": {
            "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
            "model": { "type": "string", "minLength": 1, "maxLength": 128 },
            "platform_family": { "enum": ["linux_ros2", "rtos", "closed_controller", "fieldbus", "other"] },
            "site": { "type": "string", "minLength": 1, "maxLength": 128 },
            "firmware": {
              "type": "object",
              "additionalProperties": false,
              "required": ["version", "sha256"],
              "properties": {
                "version": { "type": "string", "minLength": 1, "maxLength": 128 },
                "sha256": { "$ref": "#/$defs/Sha256" }
              }
            }
          }
        },
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "sha256"],
          "properties": {
            "version": { "type": "string", "minLength": 1, "maxLength": 128 },
            "sha256": { "$ref": "#/$defs/Sha256" }
          }
        },
        "rule_id": { "type": "string", "pattern": "^[a-z][a-z0-9._]{0,127}$" },
        "mode": { "enum": ["observe", "enforce"] },
        "safety_state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["motion", "human_proximity"],
          "properties": {
            "motion": { "enum": ["moving", "stationary", "unknown"] },
            "human_proximity": { "enum": ["detected", "not_detected", "unknown"] }
          }
        },
        "attestation": { "enum": ["verified", "deviation", "unknown"] },
        "ros": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "participant_guid": { "$ref": "#/$defs/Tainted" },
            "node": { "$ref": "#/$defs/Tainted" },
            "topic": { "$ref": "#/$defs/Tainted" },
            "type_name": { "$ref": "#/$defs/Tainted" },
            "src_ip": { "$ref": "#/$defs/Tainted" }
          }
        },
        "command": {
          "type": "object",
          "additionalProperties": false,
          "required": ["channel"],
          "properties": {
            "channel": { "$ref": "#/$defs/Tainted" },
            "linear_speed": { "type": "number", "minimum": 0 },
            "joint_speed": { "type": "number", "minimum": 0 },
            "envelope_max_linear_speed": { "type": "number", "minimum": 0 },
            "envelope_max_joint_speed": { "type": "number", "minimum": 0 }
          }
        },
        "bus_message_id": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "occurrence_count": { "type": "integer", "minimum": 1 },
        "detail": { "$ref": "#/$defs/Tainted" }
      }
    },
    "DetectionFinding": {
      "description": "OCSF 1.1 Detection Finding. Fields marked OCSF-UNCERTAIN in crates/robodr-ocsf/README.md must be confirmed against the OCSF schema server before a strict OCSF validator is put in the path.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activity_id", "activity_name", "category_uid", "category_name", "class_uid",
        "class_name", "type_uid", "type_name", "severity_id", "severity", "status_id",
        "status", "time", "message", "count", "metadata", "finding_info", "device",
        "evidences", "resources", "unmapped"
      ],
      "properties": {
        "activity_id": { "enum": [1, 2, 3] },
        "activity_name": { "enum": ["Create", "Update", "Close"] },
        "category_uid": { "const": 2 },
        "category_name": { "const": "Findings" },
        "class_uid": { "const": 2004 },
        "class_name": { "const": "Detection Finding" },
        "type_uid": { "enum": [200401, 200402, 200403] },
        "type_name": { "type": "string" },
        "severity_id": { "enum": [2, 3, 4, 5] },
        "severity": { "enum": ["Low", "Medium", "High", "Critical"] },
        "status_id": { "enum": [0, 1, 2, 3, 4, 99] },
        "status": { "enum": ["Unknown", "New", "In Progress", "Suppressed", "Resolved", "Other"] },
        "time": { "type": "integer", "minimum": 946684800000, "maximum": 4102444799999 },
        "message": { "type": "string", "maxLength": 256 },
        "count": { "type": "integer", "minimum": 1 },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "product", "uid", "log_name"],
          "properties": {
            "version": { "const": "1.1.0" },
            "product": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "vendor_name", "version"],
              "properties": {
                "name": { "const": "RoboDR" },
                "vendor_name": { "const": "Singularity RD" },
                "version": { "type": "string", "minLength": 1, "maxLength": 128 }
              }
            },
            "uid": { "type": "string", "pattern": "^re1-[0-9a-f]{32}$" },
            "log_name": { "const": "robot-edr.findings" }
          }
        },
        "finding_info": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "uid", "title", "desc", "types", "first_seen_time", "last_seen_time",
            "analytic", "attacks", "data_sources"
          ],
          "properties": {
            "uid": { "type": "string", "pattern": "^rf1-[0-9a-f]{32}$" },
            "title": { "type": "string", "maxLength": 256 },
            "desc": { "type": "string", "maxLength": 2048 },
            "types": { "type": "array", "items": { "type": "string" } },
            "first_seen_time": { "type": "integer" },
            "last_seen_time": { "type": "integer" },
            "analytic": {
              "type": "object",
              "additionalProperties": false,
              "required": ["uid", "name", "type_id", "type"],
              "properties": {
                "uid": { "type": "string" },
                "name": { "type": "string" },
                "type_id": { "const": 1 },
                "type": { "const": "Rule" }
              }
            },
            "attacks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["technique"],
                "properties": {
                  "technique": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["uid", "name"],
                    "properties": {
                      "uid": { "type": "string" },
                      "name": { "type": "string" }
                    }
                  }
                }
              }
            },
            "data_sources": { "type": "array", "items": { "type": "string" } }
          }
        },
        "device": {
          "type": "object",
          "additionalProperties": false,
          "required": ["uid", "name", "type_id", "type", "model"],
          "properties": {
            "uid": { "type": "string" },
            "name": { "type": "string" },
            "type_id": { "const": 99 },
            "type": { "const": "Robot" },
            "model": { "type": "string" }
          }
        },
        "evidences": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["data"],
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "segment", "seq", "sha256", "uri"],
                "properties": {
                  "kind": { "const": "robodr.blackbox" },
                  "segment": { "type": "integer", "minimum": 0 },
                  "seq": { "type": "integer", "minimum": 0 },
                  "sha256": { "$ref": "#/$defs/Sha256" },
                  "uri": { "type": "string", "pattern": "^robodr-blackbox://" }
                }
              }
            }
          }
        },
        "resources": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "labels"],
            "properties": {
              "type": { "enum": ["ros2.participant", "ros2.node", "ros2.topic", "ip_address"] },
              "uid": { "type": "string", "maxLength": 256 },
              "name": { "type": "string", "maxLength": 256 },
              "labels": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "unmapped": {
          "type": "object",
          "additionalProperties": false,
          "required": ["robodr"],
          "properties": {
            "robodr": { "$ref": "#/$defs/EntityContext" }
          }
        }
      }
    }
  }
}

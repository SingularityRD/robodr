{
  "description": "RoboDR robodr.findings (contract 2.x) to ECS, for findings whose signature nothing checked. The finding is kept verbatim under robodr.*; ECS fields are copied from it. Any robodr or robodr_verification object the event carries is removed first: a forger chooses the whole event, so no verification status is kept here. Verified findings go through robodr-findings-verified. Expects the finding's top-level fields at the document root. integrations/elastic/README.md.",
  "processors": [
    { "remove": { "field": "robodr", "ignore_missing": true } },
    { "remove": { "field": "robodr_verification", "ignore_missing": true } },
    { "rename": { "field": "contract_version", "target_field": "robodr.contract_version" } },
    { "rename": { "field": "finding_id", "target_field": "robodr.finding_id" } },
    { "rename": { "field": "external_id", "target_field": "robodr.external_id" } },
    { "rename": { "field": "data_source", "target_field": "robodr.data_source" } },
    { "rename": { "field": "title", "target_field": "robodr.title" } },
    { "rename": { "field": "description", "target_field": "robodr.description" } },
    { "rename": { "field": "severity", "target_field": "robodr.severity" } },
    { "rename": { "field": "timestamp", "target_field": "robodr.timestamp" } },
    { "rename": { "field": "entity_context", "target_field": "robodr.entity_context" } },
    { "rename": { "field": "mitre_predictions", "target_field": "robodr.mitre_predictions" } },
    { "rename": { "field": "evidence_links", "target_field": "robodr.evidence_links" } },
    { "rename": { "field": "anomaly_score", "target_field": "robodr.anomaly_score", "ignore_missing": true } },
    { "rename": { "field": "adversary_controlled_fields", "target_field": "robodr.adversary_controlled_fields" } },
    { "rename": { "field": "ocsf", "target_field": "robodr.ocsf" } },
    { "date": { "field": "robodr.timestamp", "target_field": "@timestamp", "formats": ["ISO8601"] } },
    { "set": { "field": "event.kind", "value": "alert" } },
    { "set": { "field": "event.category", "value": ["intrusion_detection"] } },
    { "set": { "field": "event.type", "value": ["info"] } },
    { "set": { "field": "event.module", "value": "robodr" } },
    { "set": { "field": "event.dataset", "value": "robodr.findings" } },
    { "set": { "field": "observer.vendor", "value": "Singularity RD" } },
    { "set": { "field": "observer.product", "value": "RoboDR" } },
    { "set": { "field": "observer.type", "value": "ids" } },
    { "set": { "field": "event.id", "copy_from": "robodr.ocsf.metadata.uid" } },
    { "set": { "field": "rule.id", "copy_from": "robodr.entity_context.rule_id" } },
    { "set": { "field": "rule.name", "copy_from": "robodr.title" } },
    { "set": { "field": "rule.description", "copy_from": "robodr.description" } },
    { "set": { "field": "rule.ruleset", "copy_from": "robodr.ocsf.finding_info.data_sources" } },
    { "set": { "field": "event.severity", "copy_from": "robodr.ocsf.severity_id" } },
    { "set": { "field": "log.level", "copy_from": "robodr.severity" } },
    { "set": { "field": "host.id", "copy_from": "robodr.entity_context.robot.id" } },
    { "set": { "field": "host.name", "copy_from": "robodr.entity_context.robot.id" } },
    { "set": { "field": "observer.geo.name", "copy_from": "robodr.entity_context.robot.site" } },
    { "set": { "field": "robodr.mode", "copy_from": "robodr.entity_context.mode" } },
    { "set": { "field": "source.ip", "value": "{{{robodr.entity_context.ros.src_ip.display}}}", "ignore_empty_value": true } },
    { "convert": { "field": "source.ip", "type": "ip", "ignore_missing": true,
        "on_failure": [ { "remove": { "field": "source.ip" } } ] } },
    { "set": { "field": "robodr.ros.topic", "value": "{{{robodr.entity_context.ros.topic.display}}}", "ignore_empty_value": true } },
    { "set": { "field": "robodr.ros.participant", "value": "{{{robodr.entity_context.ros.participant_guid.display}}}", "ignore_empty_value": true } },
    { "foreach": { "field": "robodr.mitre_predictions", "ignore_missing": true,
        "processor": { "append": { "field": "threat.technique.id", "value": "{{{_ingest._value.technique_id}}}", "allow_duplicates": false } } } },
    { "foreach": { "field": "robodr.mitre_predictions", "ignore_missing": true,
        "processor": { "append": { "field": "threat.technique.name", "value": "{{{_ingest._value.technique_name}}}", "allow_duplicates": false } } } },
    { "foreach": { "field": "robodr.mitre_predictions", "ignore_missing": true,
        "processor": { "set": { "field": "threat.framework", "value": "MITRE ATT&CK for ICS" } } } }
  ],
  "on_failure": [
    { "set": { "field": "event.kind", "value": "pipeline_error" } },
    { "set": { "field": "error.message", "value": "{{{_ingest.on_failure_message}}}" } }
  ]
}
